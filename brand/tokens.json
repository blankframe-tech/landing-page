{
  "color": {
    "bg":          { "light": "#F8FAFC", "dark": "#0E0E10", "use": "Page background" },
    "card":        { "light": "#FFFFFF", "dark": "#18181B", "use": "Cards, sheets, inputs" },
    "ink":         { "light": "#18181B", "dark": "#F4F4F5", "use": "Body text, primary buttons" },
    "ink-soft":    { "light": "#27272A", "dark": "#D4D4D8", "use": "Secondary headings, hover ink" },
    "muted":       { "light": "#71717A", "dark": "#A1A1AA", "use": "Supporting text, captions" },
    "faint":       { "light": "#A1A1AA", "dark": "#71717A", "use": "Placeholders, decoration only (not body text)" },
    "line":        { "light": "#E4E4E7", "dark": "#2A2A2E", "use": "Borders, dividers" },
    "accent":      { "light": "#3B82F6", "dark": "#60A5FA", "use": "Brand blue: marks, highlights, large type" },
    "accent-text": { "light": "#2563EB", "dark": "#60A5FA", "use": "Links, small accent text, filled accent buttons" },
    "on-accent":   { "light": "#FFFFFF", "dark": "#0E0E10", "use": "Text on accent-text fills" }
  },
  "font": {
    "display": ["Inter Tight", "Inter", "sans-serif"],
    "body":    ["Inter", "-apple-system", "sans-serif"],
    "serif":   ["Instrument Serif", "serif"]
  },
  "radius": { "sm": 12, "md": 20, "lg": 28, "pill": 999 },
  "space":  { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64, "24": 96 },
  "layout": { "max-w": 1140 },
  "motion": { "ease": [0.22, 0.61, 0.36, 1], "fast": 200, "base": 300, "slow": 650 },
  "shadow": {
    "card": "0 1px 2px rgba(19,19,19,0.04), 0 10px 30px -12px rgba(19,19,19,0.10)",
    "pill": "0 1px 2px rgba(19,19,19,0.06), 0 12px 32px -14px rgba(19,19,19,0.18)"
  }
}
